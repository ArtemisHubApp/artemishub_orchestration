{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/submodule_context.py\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(**/.venv/**)",
      "Read(**/node_modules/**)",
      "Read(**/data/**)",
      "Read(**/chroma*/**)",
      "Read(**/*.lock)"
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true
  }
}
